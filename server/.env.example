# GLOBEHUNT multiplayer server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
# Comma-separated browser origins allowed to connect (your frontend URL). Required in production.
ALLOWED_ORIGINS=https://globehunt.example.com
# Set to 1 when behind a reverse proxy/load balancer that sets X-Forwarded-For.
TRUST_PROXY=1
# Optional: folder containing game/pool.json and data/countries-110m.json (defaults to the repo's public/).
# PUBLIC_DIR=/srv/globehunt/public
