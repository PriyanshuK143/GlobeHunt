# Frontend build-time config: the public HTTPS URL of the game server (Socket.IO uses WSS).
# Required for production builds (Cloudflare Pages fails the build without it), e.g. a Render service.
# Leave unset in development: the Vite dev server proxies /socket.io to localhost:3001.
VITE_SERVER_URL=https://globehunt-server.onrender.com
